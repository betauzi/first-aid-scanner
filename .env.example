# Server-only values. Do not expose these in client builds.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Public client configuration. Never place secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://portal.example.com
EXPO_PUBLIC_OAUTH_SERVER_URL=https://oauth.example.com
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
